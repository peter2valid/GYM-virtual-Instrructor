# =============================================================================
# VirtualGYM — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# App URL (required)
# Canonical public URL — no trailing slash.
# Used for QR code generation, email links, and metadata base.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# -----------------------------------------------------------------------------
# Member QR Code signing secret (required for personal check-in QR codes)
# Generate with: openssl rand -hex 32
# Must match across all app instances/deployments.
# -----------------------------------------------------------------------------
MEMBER_QR_SECRET=your-random-secret-here

# -----------------------------------------------------------------------------
# Paystack (required for billing)
# Get from: https://dashboard.paystack.com/#/settings/developers
# Use sk_test_... for development, sk_live_... for production.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# -----------------------------------------------------------------------------
# Sentry (optional — error tracking)
# Create a project at https://sentry.io and copy the DSN from Project Settings.
# SENTRY_AUTH_TOKEN is only needed for source map uploads at build time.
# Get auth token from: https://sentry.io/settings/account/api/auth-tokens/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=virtualgym

# -----------------------------------------------------------------------------
# Resend (optional — transactional email)
# Create an account at https://resend.com and add your domain.
# Get your API key from: https://resend.com/api-keys
# RESEND_FROM_EMAIL defaults to "VirtualGYM <noreply@virtualgym.app>" if not set.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=VirtualGYM <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Cloudflare R2 (optional — media uploads for logos and workout assets)
# Create a bucket at: https://dash.cloudflare.com -> R2
# Create an R2 API token with Object Read & Write permissions.
# NEXT_PUBLIC_R2_PUBLIC_URL is the public domain for your bucket
#   e.g. https://pub-xxxxxx.r2.dev  OR  https://media.yourdomain.com
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=virtualgym-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
